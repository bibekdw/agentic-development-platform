{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADLC cross-repository pinned change manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_id",
    "repositories",
    "required_checks",
    "production_approval_required"
  ],
  "properties": {
    "change_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "revision"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{40}$"
          },
          "pr_number": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "production_approval_required": {
      "type": "boolean",
      "const": true
    }
  }
}
